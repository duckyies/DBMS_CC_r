// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReleaseType {
  Single
  EP
  Album
}

model User {
  user_id       Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  is_artist     Boolean  @default(false)
  created_at    DateTime @default(now())
  last_login    DateTime?

  // Relations
  artist              Artist?
  playlists           Playlist[]             @relation("PlaylistCreator")
  playlist_collabs    Playlist_Collaborator[]
  listening_activity  Listening_Activity[]
  following           Follow[]               @relation("Follower")
  followers           Follow[]               @relation("Followed")

  @@map("User")
}

model Artist {
  user_id             Int      @id
  name                String   @db.VarChar(255)
  country             String?  @db.VarChar(100)
  is_band             Boolean  @default(false)
  band_member_ids     Json?
  country_of_origin   String?  @db.VarChar(100)
  production_house_id Int?
  created_at          DateTime @default(now())

  // Relations
  user              User                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  production_house  Production_House?       @relation(fields: [production_house_id], references: [production_house_id])
  songs             Song_Artist_Relationship[]

  @@index([country])
  @@map("Artist")
}

model Production_House {
  production_house_id Int    @id @default(autoincrement())
  name                String @unique @db.VarChar(255)
  type                String @db.VarChar(100)

  // Relations
  artists Artist[]

  @@map("Production_House")
}

model Song {
  song_id      Int      @id @default(autoincrement())
  song_name    String   @db.VarChar(255)
  duration     Int      // in seconds
  publish_date DateTime @db.Date
  genres       Json
  listen_count  Int?     // optional; null when unused
  is_published  Boolean  @default(true)
  file_path     String?  @db.VarChar(500)
  downloaded_at DateTime?
  album         String?  @db.VarChar(255)
  cover_art_url String?  @db.VarChar(500)

  // Relations
  artists            Song_Artist_Relationship[]
  playlist_songs     Playlist_Song[]
  listening_activity Listening_Activity[]
  lyrics             Lyrics[]

  @@map("Song")
}

model Song_Artist_Relationship {
  song_id    Int
  artist_id  Int
  role       String  @db.VarChar(100)
  is_primary Boolean @default(false)

  // Relations
  song   Song   @relation(fields: [song_id], references: [song_id], onDelete: Cascade)
  artist Artist @relation(fields: [artist_id], references: [user_id], onDelete: Cascade)

  @@id([song_id, artist_id])
  @@map("Song_Artist_Relationship")
}

model Playlist {
  playlist_id         Int          @id @default(autoincrement())
  name                String       @db.VarChar(255)
  created_by_user_id  Int
  cover_art_url       String?      @db.VarChar(500)
  duration            Int          @default(0) // total seconds
  release_type        ReleaseType?
  last_updated        DateTime     @default(now()) @updatedAt
  is_shared           Boolean      @default(false)

  // Relations
  creator       User                    @relation("PlaylistCreator", fields: [created_by_user_id], references: [user_id])
  songs         Playlist_Song[]
  collaborators Playlist_Collaborator[]

  @@map("Playlist")
}

model Playlist_Song {
  playlist_id Int
  song_id     Int
  order       Int @default(0)

  // Relations
  playlist Playlist @relation(fields: [playlist_id], references: [playlist_id], onDelete: Cascade)
  song     Song     @relation(fields: [song_id], references: [song_id], onDelete: Cascade)

  @@id([playlist_id, song_id])
  @@map("Playlist_Song")
}

model Playlist_Collaborator {
  playlist_id Int
  user_id     Int

  // Relations
  playlist Playlist @relation(fields: [playlist_id], references: [playlist_id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([playlist_id, user_id])
  @@map("Playlist_Collaborator")
}

model Follow {
  follower_user_id Int
  followed_user_id Int

  // Relations
  follower User @relation("Follower", fields: [follower_user_id], references: [user_id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followed_user_id], references: [user_id], onDelete: Cascade)

  @@id([follower_user_id, followed_user_id])
  @@map("Follow")
}

// ─── Ignored for MVP implementation ───────────────────────────────────────────

model Listening_Activity {
  activity_id    Int      @id @default(autoincrement())
  user_id        Int
  song_id        Int
  listening_time Int      // seconds
  timestamp      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])
  song Song @relation(fields: [song_id], references: [song_id])

  @@map("Listening_Activity")
}

model Lyrics {
  lyrics_id       Int    @id @default(autoincrement())
  song_id         Int
  lyrics_text     String @db.LongText
  lyrics_filename String @db.VarChar(255)

  song Song @relation(fields: [song_id], references: [song_id])

  @@map("Lyrics")
}
