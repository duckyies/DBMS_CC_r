MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=music_library

# Only used when running the backend outside Docker (docker-compose builds its own from the values above).
# Keep the password URL-safe (letters and digits) or percent-encode special characters.
DATABASE_URL=mysql://root:your_mysql_root_password@db:3306/music_library

JWT_SECRET=your_very_long_random_secret_here

PORT=3001

# "development" adds error details to 500 responses; leave as "production" on a public VM
APP_ENV=production

# Load the demo users/songs/playlists on startup (alice, bob, charlie / password123). Set to false for a clean DB.
SEED_DEMO_DATA=true
